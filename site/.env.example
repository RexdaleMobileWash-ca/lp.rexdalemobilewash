# Image host (AD-9). Optional — src/lib/img.ts already defaults to this value,
# so a plain `npm run build` on a fresh clone produces correct URLs. Set it only
# to point a build at a different bucket or hostname.
#
# It must be a BUILD variable, never a Worker secret: every page is prerendered,
# so a runtime secret is not read during the build and the image URLs come out
# as `undefined/...`.
PUBLIC_IMG_BASE=https://img-lp.rexdalemobilewash.ca
