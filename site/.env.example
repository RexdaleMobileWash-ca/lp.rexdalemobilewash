# Image host (AD-9). Optional — src/lib/img.ts already defaults to this value,
# so a plain `npm run build` on a fresh clone produces correct URLs. Set it only
# to point a build at a different bucket or hostname.
#
# It must be a BUILD variable, never a Worker secret: every page is prerendered,
# so a runtime secret is not read during the build and the image URLs come out
# as `undefined/...`.
PUBLIC_IMG_BASE=https://img-lp.rexdalemobilewash.ca

# reCAPTCHA v3 SITE key (the public half). Optional for the same reason as
# above — src/lib/recaptcha.ts already defaults to the client's key, so a fresh
# clone builds correct pages. Set it only to point a build at a different key
# pair, and remember the Worker's RECAPTCHA_SECRET has to be the matching half
# or every submission is refused with `invalid-input-secret`.
#
# It must be a BUILD variable for the same reason: the key is baked into every
# prerendered page, so a runtime value comes out `undefined`.
#
# The SECRET key is NOT here and never goes in this file or in wrangler.jsonc
# vars. It is a Worker secret:
#     CLOUDFLARE_API_TOKEN="$CF_API_TOKEN" npx wrangler secret put RECAPTCHA_SECRET --env ""
PUBLIC_RECAPTCHA_SITE_KEY=6LcalvUqAAAAAHu88pu8kNJ844UNgiAOftYRurlF
