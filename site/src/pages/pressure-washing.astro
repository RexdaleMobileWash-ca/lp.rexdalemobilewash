      .f7:focus{border-color:#C4141A !important;background:#FFFFFF !important}

      /* <sc-if> became a display:contents wrapper; [hidden] has to beat that. */
      [hidden] { display: none !important; }

      /* Was {{ heroScrim }}: the copy sits left of the photo on desktop and on
         top of it once the hero stacks. */
      .pw-hero-scrim {
