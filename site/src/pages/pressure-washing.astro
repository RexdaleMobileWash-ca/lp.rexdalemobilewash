    <script is:inline>
      (function () {
        /* ------------------------------------------------------------------
           Both quote forms post to POST /api/contact — the same Worker route
           the estimate forms on / use, which sends through Resend. They used
           to post to Web3Forms with an empty access key, which meant they were
           not connected at all.

           The forms carry method/action too, so a visitor with no JavaScript
           gets a plain POST and a 303 to /thank-you. This script only upgrades
           that to a fetch, which is what keeps the in-page success panel and
           the error message beside the button.
           ------------------------------------------------------------------ */
        var ENDPOINT = '/api/contact';

        var PHONE = "1 (416) 244-6497";

        /* ---- FAQ accordion ---- */
        Array.prototype.forEach.call(
          document.querySelectorAll('[data-click="toggleFaq"]'),
          function (btn) {
            btn.addEventListener('click', function () {
              var panel = document.getElementById(btn.getAttribute('aria-controls'));
              var open = btn.getAttribute('aria-expanded') !== 'true';
              btn.setAttribute('aria-expanded', open ? 'true' : 'false');
              if (panel) panel.style.display = open ? 'block' : 'none';
              var sign = btn.querySelector('span[aria-hidden="true"]');
              if (sign) sign.textContent = open ? '\u2013' : '+';
            });
          }
        );

        /* ---- photo carousels ---- */
        var CAROUSEL_MS = 5000;
        var reduced =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        Array.prototype.forEach.call(
          document.querySelectorAll('[role="group"][aria-label="Photo carousel"]'),
          function (box) {
            var imgs = box.querySelectorAll('img');
            var dots = box.querySelectorAll('[data-click="pickSlide"]');
            if (imgs.length < 2) return;
            var idx = 0;
            var timer = null;

            function show(n) {
              idx = ((n % imgs.length) + imgs.length) % imgs.length;
              Array.prototype.forEach.call(imgs, function (img, i) {
                img.style.opacity = i === idx ? '1' : '0';
              });
              Array.prototype.forEach.call(dots, function (dot, i) {
                var pip = dot.firstElementChild;
                if (pip) pip.style.background = i === idx ? '#FFFFFF' : 'rgba(255,255,255,.45)';
              });
            }

            function start() {
              if (reduced) return;
              clearInterval(timer);
              timer = setInterval(function () { show(idx + 1); }, CAROUSEL_MS);
            }

            Array.prototype.forEach.call(dots, function (dot, i) {
              dot.addEventListener('click', function () { show(i); start(); });
            });

            start();
          }
        );

        /* ---- sticky call/quote bar, mobile only (CSS gates the width) ---- */
        var hero = document.getElementById('top');
        function onScroll() {
          var past = window.scrollY > (hero ? hero.offsetHeight - 120 : 500);
          document.body.classList.toggle('pw-past-hero', past);
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();

        /* ---- quote forms ---- */
        Array.prototype.forEach.call(
          document.querySelectorAll('form[data-submit]'),
          function (form) {
            var which = form.getAttribute('data-submit') === 'submitHero' ? 'hero' : 'final';
            var alertBox = form.querySelector('[role="alert"]');
            var button = form.querySelector('button[type="submit"]');
            var labels = button ? button.querySelectorAll('span') : [];
            var formPane = document.querySelector('[data-if="' + which + 'FormShow"]');
            var donePane = document.querySelector('[data-if="' + which + 'SuccessShow"]');

            function busy(on) {
              if (button) button.disabled = on;
              if (labels.length > 1) {
                labels[0].style.display = on ? 'none' : 'inline';
                labels[1].style.display = on ? 'inline' : 'none';
              }
            }

            function fail(message, fieldErrors) {
              busy(false);
              if (!alertBox) return;
              /* The Worker answers a 400 with a per-field map as well as a
                 generic sentence. Prefer the specific ones — a mistyped email
                 is something the visitor can fix, and telling them to phone
                 instead loses a lead we already had. */
              var listed = fieldErrors
                ? Object.keys(fieldErrors).map(function (k) { return fieldErrors[k]; })
                : [];
              var text = listed.length
                ? listed.join(' ')
                : message +
                  " Your request didn't go through — please call " + PHONE +
                  " and we'll take the details over the phone.";
              /* Reveal BEFORE writing. A live region that is display:none at
                 the moment its contents change is not in the accessibility
                 tree then, so nothing is announced. */
              alertBox.textContent = '';
              alertBox.style.display = 'block';
              if (window.requestAnimationFrame) {
                requestAnimationFrame(function () { alertBox.textContent = text; });
              } else {
                alertBox.textContent = text;
              }
            }

            form.addEventListener('submit', function (e) {
              e.preventDefault();
              if (!form.reportValidity()) return;
              if (alertBox) alertBox.style.display = 'none';

              busy(true);
              var data = {};
              new FormData(form).forEach(function (value, key) { data[key] = value; });

              fetch(form.getAttribute('action') || ENDPOINT, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
                body: JSON.stringify(data)
              })
                .then(function (r) {
                  return r
                    .json()
                    .catch(function () { return {}; })
                    .then(function (j) { return { ok: r.ok, body: j }; });
                })
                .then(function (res) {
                  if (!res.ok) {
                    /* The Worker answers {ok:false, error:"…"} — a sentence
                       already written for a visitor to read — plus, on a 400,
                       an `errors` map keyed by field. Carry both to fail(). */
                    var err = new Error(
                      (res.body && res.body.error) || 'Submission was rejected.'
                    );
                    err.userFacing = true;
                    err.fieldErrors = res.body && res.body.errors;
                    throw err;
                  }
                  /* generate_lead fires only after the Worker confirms the
                     notification was accepted — firing it on click would
                     inflate conversions with abandoned and failed
                     submissions. */
                  window.dataLayer = window.dataLayer || [];
                  window.dataLayer.push({ event: 'generate_lead' });
                  busy(false);
                  if (formPane) formPane.hidden = true;
                  if (donePane) donePane.hidden = false;
                  /* Scroll the panel INSIDE donePane, not donePane itself: the
                     pane is display:contents, so it generates no box, and
                     scrollIntoView on a boxless element returns early without
                     doing anything. Focus it too, or a keyboard or screen
                     reader user is left where the form used to be. */
                  var doneBox = donePane && donePane.querySelector('[role="status"]');
                  if (doneBox) {
                    doneBox.setAttribute('tabindex', '-1');
                    if (doneBox.scrollIntoView) {
                      doneBox.scrollIntoView({ block: 'center', behavior: 'smooth' });
                    }
                    if (doneBox.focus) doneBox.focus({ preventScroll: true });
                  }
                })
                .catch(function (err) {
                  /* A message thrown from the .then above is the Worker's, and
                     is a sentence written for a visitor to read. A fetch
                     rejection is a browser-internal TypeError ("Failed to
                     fetch") and must never reach the page. */
                  fail(
                    err && err.userFacing ? err.message : 'We could not reach the server.',
                    err && err.fieldErrors
                  );
                });
            });
          }
        );
      })();
    </script>
  </body>
</html>
