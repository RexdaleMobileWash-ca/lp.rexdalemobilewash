      /* Hoisted from the design's style-hover / style-focus attributes. The base
         styles are inline, so these have to be !important to win. */
      .h0:hover{color:#B5121A !important}
      .h2:hover{background:#0D5A9F !important;color:#FFFFFF !important}
      .h4:hover{background:#0D5A9F !important}
