---
/**
 * Commercial / industrial pressure washing landing page.
 *
 * Ported from the "Rexdale Mobile Wash — Commercial LP V03" design export. That
 * export was a 30MB single file: a React runtime that rendered a template at
 * load time, with every image and font inlined as base64. Neither half of that
 * survives here — Cloudflare rejects a static asset over 25MiB, and a landing
 * page carrying paid traffic should not be blank until React boots.
 *
 * So the template was resolved to plain HTML at build time instead:
 *   - the design's {{ bindings }} are baked to their initial render state
 *   - viewport-dependent bindings (hero scrim, header sizing, the sticky mobile
 *     bar) became media queries, so nothing about the layout waits on JS
 *   - style-hover / style-focus became the .h* / .f* rules below
 *   - photos were re-encoded to WebP at 2x their layout box: 22.7MB -> 1.6MB
 *   - fonts are self-hosted under /pw-assets/fonts
 * Behaviour that is genuinely interactive — accordion, carousels, sticky bar,
 * form submission — is the vanilla script at the end of the body.
 *
 * This page deliberately does NOT use layouts/Base.astro: it is a separate
 * design system (Barlow/Oswald, blue/red) from the rest of this site
 * (Montserrat/Source Sans), and Base's global styles would fight it.
 */
const CANONICAL = 'https://lp.rexdalemobilewash.ca/pressure-washing/';
const TITLE = 'Commercial Pressure Washing Toronto | Rexdale Mobile Wash';
const DESC =
  'Commercial & industrial pressure washing across the GTA since 1966. Building exteriors, plant and warehouse floors, power scrubbing. Free on-site quote.';
const SHARE = 'https://lp.rexdalemobilewash.ca/pw-assets/img/hero-building-exterior.webp';

// Structured data, carried over from the design unchanged: it describes the
// business and the FAQ answers rendered further down the page.
const BUSINESS_LD = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "Rexdale Mobile Wash Inc.",
  "description": "Commercial and industrial pressure washing contractor serving the Greater Toronto Area since 1966.",
  "url": "https://www.rexdalemobilewash.ca/",
  "telephone": "+14162446497",
  "email": "dispatch@rexdalemobilewash.ca",
  "foundingDate": "1966",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "41 Shaft Rd",
    "addressLocality": "Etobicoke",
    "addressRegion": "ON",
    "postalCode": "M9W 4M3",
    "addressCountry": "CA"
  },
  "areaServed": [
    "Toronto",
    "Etobicoke",
    "North York",
    "Scarborough",
    "Mississauga",
    "Brampton",
    "Vaughan",
    "Woodbridge",
    "Concord",
    "Markham",
    "Richmond Hill",
    "Oakville",
    "Burlington",
    "Milton",
    "Caledon",
    "Pickering",
    "Ajax",
    "Newmarket"
  ]
};

const FAQ_LD = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Are you insured, and can you provide a certificate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We carry commercial general liability insurance and maintain WSIB clearance. We provide certificates of insurance and clearance certificates before work begins, and we're familiar with the vendor compliance paperwork most property management firms and industrial facilities require."
      }
    },
    {
      "@type": "Question",
      "name": "Do you work outside of business hours?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Most of our commercial and industrial work happens at night, on weekends, or during scheduled shutdowns so it doesn't interfere with your operation."
      }
    },
    {
      "@type": "Question",
      "name": "Do you need us to supply water?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. We operate our own water tankers and can bring water to your site. If a hookup is available we can use it, but we don't depend on one."
      }
    },
    {
      "@type": "Question",
      "name": "Can you clean production areas in a food facility?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. We clean and disinfect production areas and equipment for food and manufacturing companies, including in preparation for government audits, and we work to your site's sanitation and access procedures."
      }
    },
    {
      "@type": "Question",
      "name": "Will pressure washing damage our building?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We assess the substrate before we start and match pressure, temperature and method to the material. Aged masonry, coated surfaces and stucco are soft washed at low pressure; durable concrete and metal take full high pressure."
      }
    },
    {
      "@type": "Question",
      "name": "Can you get oil staining out of concrete?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In most cases, yes. We combine power scrubbing with hot water and degreasing agents to lift staining out of the pore structure. Depth and age of the staining determine how much comes out — we'll tell you honestly what to expect at the assessment."
      }
    },
    {
      "@type": "Question",
      "name": "What happens to the waste water?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We use biodegradable cleaning agents and contain and manage wash water in line with local discharge requirements."
      }
    },
    {
      "@type": "Question",
      "name": "Do you offer recurring or scheduled service?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Many of our commercial clients are on regular programs — monthly, quarterly or seasonal."
      }
    }
  ]
};
