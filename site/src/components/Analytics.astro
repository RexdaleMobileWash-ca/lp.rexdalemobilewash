---
/**
 * Google Ads + Microsoft Clarity — ported verbatim from the live WordPress page.
 *
 * WHY THIS IS HARDCODED RATHER THAN CONFIGURED IN GTM
 *
 * lp.rexdalemobilewash.ca carries paid Google Ads traffic. The live Elementor
 * theme fires these tags from hardcoded snippets, not through a container, so
 * the moment the domain is repointed at this build anything not carried across
 * stops counting. Conversion history is not backfillable. These four snippets
 * are therefore reproduced character-for-character from the live page rather
 * than reimplemented, so that the cutover is invisible in the Ads account.
 *
 * Captured from https://lp.rexdalemobilewash.ca/ and /thank-you/ on 2026-09-08.
 *
 * ---------------------------------------------------------------------------
 * DOUBLE-COUNTING: the one way this goes wrong
 *
 * This build also loads GTM container GTM-NMTLRJ63 (see Base.astro). If that
 * container is ever configured to fire conversions for AW-16946176869 while
 * these snippets are also present, every conversion counts TWICE and the Ads
 * account optimises against inflated numbers.
 *
 * Pick one place. Today it is here. If the conversions move into GTM, delete
 * this component in the same change — not afterwards.
 * ---------------------------------------------------------------------------
 *
 * Clarity has no equivalent hazard: a second copy of the same project id is
 * de-duplicated by the tag itself.
 */

interface Props {
  /**
   * A full `AW-…/label` send_to value. When set, a conversion event fires on
   * page load. Only /thank-you/ passes one — it is the form-submission
   * conversion, and the page is reachable only after the Worker's 303.
   */
  conversion?: string;
}

const { conversion } = Astro.props;
---

<!-- Google Ads: gtag.js (AW-16946176869) -->
<script
  is:inline
  async
  src="https://www.googletagmanager.com/gtag/js?id=AW-16946176869"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag() {
    dataLayer.push(arguments);
  }
  gtag('js', new Date());

  gtag('config', 'AW-16946176869');
</script>

<!--
  Call conversion + number swap. The swap target is the number this site
  already displays, so the visible page is unchanged whether or not Ads
  substitutes a forwarding number.
-->
<script is:inline>
  gtag('config', 'AW-16946176869/jqC8COOXo64aEOXGyJA_', {
    phone_conversion_number: '(416) 244-6497',
  });
</script>

{
  /* Form conversion. Fires on load, not on submit — the page is only reached
     after the Worker has accepted the submission, so a load here is a real
     lead, and abandoned or failed submissions never get counted. */
  conversion && (
    <script
      is:inline
      set:html={`gtag('event', 'conversion', {'send_to': '${conversion}'});`}
    />
  )
}

<!-- Microsoft Clarity (qsc0wq5qpr) -->
<script is:inline>
  (function (c, l, a, r, i, t, y) {
    c[a] =
      c[a] ||
      function () {
        (c[a].q = c[a].q || []).push(arguments);
      };
    t = l.createElement(r);
    t.async = 1;
    t.src = 'https://www.clarity.ms/tag/' + i;
    y = l.getElementsByTagName(r)[0];
    y.parentNode.insertBefore(t, y);
  })(window, document, 'clarity', 'script', 'qsc0wq5qpr');
</script>
