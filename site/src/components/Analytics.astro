/**
 * Microsoft Clarity.
 *
 * WHAT USED TO BE HERE, AND WHY IT ISN'T
 *
 * This component also carried the Google Ads tag hardcoded — the gtag.js
 * loader for AW-16946176869, its config call, the call conversion
 * (jqC8COOXo64aEOXGyJA_) with the (416) 244-6497 number swap, and the form
 * conversion (cnvWCPKRo64aEOXGyJA_) fired on /thank-you/. They were ported
 * verbatim from the live WordPress page so the cutover would be invisible in
 * the Ads account.
 *
 * The build also loads GTM container GTM-NMTLRJ63 (see Base.astro, and
 * pressure-washing.astro which carries its own copy). Ads tagging has to live
 * in exactly one of those two places: with the snippet here AND a container
 * tag firing the same conversion, every conversion counts twice and the Ads
 * account optimises against inflated numbers. It is now the container's job,
 * so the snippet is gone.
 *
 * What GTM-NMTLRJ63 must therefore cover, since nothing on the page does it
 * any more:
 *   - the Google Ads tag for AW-16946176869 on every page
 *   - the call conversion, including the (416) 244-6497 number swap
 *   - the form conversion, on the /thank-you/ page view
 *
 * /thank-you/ is reachable only after worker/contact.js has accepted a
 * submission, so a page view there is a real lead — a URL trigger on that path
 * reproduces the old on-load semantics exactly, and abandoned or failed
 * submissions still never count.
 *
 * Clarity stays hardcoded: it is not an Ads tag, has no double-counting
 * hazard (a second copy of the same project id is de-duplicated by the tag
 * itself), and nothing about it depends on the container.
 */
---

<!-- Microsoft Clarity (qsc0wq5qpr) -->
<script is:inline>
  (function (c, l, a, r, i, t, y) {
    c[a] =
      c[a] ||
      function () {
        (c[a].q = c[a].q || []).push(arguments);
      };
    t = l.createElement(r);
    t.async = 1;
    t.src = 'https://www.clarity.ms/tag/' + i;
    y = l.getElementsByTagName(r)[0];
    y.parentNode.insertBefore(t, y);
  })(window, document, 'clarity', 'script', 'qsc0wq5qpr');
</script>
