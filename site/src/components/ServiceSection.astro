---
/**
 * The four alternating service blocks, ported from post-110.css.
 *
 * light tone (#1b75439 bulk water, #30aafbe storefront)
 *   bg #FCFDFC, heading #164E83, body/list #000, button white/blue,
 *   image frame shadow -8px -8px 0 10px #164E83
 *
 * dark tone (#d6ce5d3 graffiti, #0ed65bb de-icing)
 *   bg #164E83, heading #D4E4ED, body/list #FFF, button blue/white,
 *   image frame shadow 8px -8px 0 10px #DFEBFF
 *
 * Media column is 40%, copy column 60% at >=768px; 50/50 in the 768-1024
 * band; stacked below that. The dark sections put the copy first in source
 * order so the text leads on desktop, and their media column carries
 * --order:-99999 at <=767px so the photo leads on a phone — every block on
 * the live site opens with its image at mobile.
 */
import { icons } from '../icons';

interface Props {
  id: string;
  eid: string;
  title: string;
  image: string;
  alt: string;
  tone: 'light' | 'dark';
  mediaFirst?: boolean;
  body: string;
  bullets: string[];
  note?: string;
}
const {
  id,
  eid,
  title,
  image,
  alt,
  tone,
  mediaFirst = true,
  body,
  bullets,
  note,
} = Astro.props;

/**
 * WordPress generates 300 / 768 / 1024 / full variants of each of these
 * photos and the live page ships them all as a srcset. Hotlinking only the
 * 1141px original made a phone download the full file to paint a 315px box —
 * and resample from a different source than the live site does.
 */
const stem = image.replace(/\.webp$/, '');
const srcset = image.endsWith('.webp')
  ? [
      `${stem}-300x220.webp 300w`,
      `${stem}-768x563.webp 768w`,
      `${stem}-1024x751.webp 1024w`,
      `${image} 1141w`,
    ].join(', ')
  : undefined;
---

<section class={`svc svc--${tone}`} id={id} data-eid={eid}>
  <div class="svc__inner">
    <div class={`svc__media ${mediaFirst ? '' : 'svc__media--last'}`}>
      <img
        src={image}
        srcset={srcset}
        sizes="(max-width: 1141px) 100vw, 1141px"
        alt={alt}
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="svc__copy">
      <h2 class={`h-sec ${tone === 'dark' ? 'on-blue' : ''}`}>{title}</h2>
      <p class="svc__body">{body}</p>

      <ul class="ticks">
        {
          bullets.map((b) => (
            <li>
              {/* fa-check-circle, as on the live list — a filled disc with a
                  knocked-out tick, not a bare check mark */}
              <svg viewBox={icons.checkCircle.vb} aria-hidden="true">
                <path d={icons.checkCircle.d} />
              </svg>
              <span>{b}</span>
            </li>
          ))
        }
      </ul>

      {note && <p class="svc__note">{note}</p>}

      <a href="#inquiry" class={`btn ${tone === 'dark' ? 'btn-dark' : 'btn-light'}`}>
        Request Quote
      </a>
    </div>
  </div>
</section>

<style>
  .svc {
    padding: 100px 10px;
  }

  .svc--light {
    background-color: var(--c-offwhite);
  }

  .svc--dark {
    background-color: var(--c-blue);
  }

  .svc__inner {
    width: 100%;
    max-width: var(--wrap-max);
    margin-inline: auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
  }

  .svc__media {
    width: 100%;
    padding: 10px;
  }

  /* Elementor spaces the widgets in this column a uniform 20px apart; the
     port used each widget's own bottom margin instead, which came out
     10/16/20/20 and left every service block short. */
  .svc__copy {
    width: 100%;
    padding: 10px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    row-gap: 20px;
  }

  .svc__copy > * {
    width: 100%;
  }

  .svc__copy > .btn {
    width: auto;
  }

  .svc__copy .h-sec,
  .svc__copy .ticks {
    margin: 0;
  }

  /* img width:90%, centred in its column, plus the offset frame shadow.
     The live image widget is centre-aligned at every width — left-aligning it
     put the frame hard against the section padding on a phone. */
  .svc__media img {
    width: 90%;
    margin-inline: auto;
  }

  .svc--light .svc__media img {
    box-shadow: -8px -8px 0 10px var(--c-blue);
  }

  .svc--dark .svc__media img {
    box-shadow: 8px -8px 0 10px var(--c-frame-pale);
  }

  /* 0.9em is the theme's paragraph margin — it sits inside the widget, on top
     of the 20px the column already puts between widgets. */
  .svc__body {
    font-family: var(--f-body);
    font-size: 16px;
    font-weight: 400;
    margin: 0 0 0.9rem;
  }

  .svc__note {
    font-style: italic;
    font-weight: 700;
    margin: 0 0 0.9rem;
  }

  .svc--light .svc__body,
  .svc--light .ticks {
    color: #000;
  }

  .svc--light .ticks svg {
    fill: var(--c-blue);
  }

  .svc--dark .svc__body,
  .svc--dark .ticks,
  .svc--dark .svc__note {
    color: #fff;
  }

  .svc--dark .ticks svg {
    fill: var(--c-blue-pale);
  }

  @media (min-width: 768px) {
    .svc__inner {
      width: 80vw;
    }
    .svc__media {
      width: 40%;
    }
    .svc__copy {
      width: 60%;
    }
    .svc__media--last {
      order: 2;
    }
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .svc__inner {
      width: 100vw;
    }
    .svc__media,
    .svc__copy {
      width: 50%;
    }
  }

  @media (max-width: 1024px) {
    .svc__media {
      z-index: 0;
    }
  }

  @media (max-width: 767px) {
    .svc {
      padding: 50px 10px;
    }
    .svc__body,
    .svc__note {
      text-align: center;
    }

    /* Every service block leads with its image at mobile.
       post-110.css carries `--order:-99999` in its (max-width:767px) block on
       #5f04353 and #7c20b1e — and both of those are MEDIA columns, not copy
       columns: #5f04353 is the second child of the graffiti section #d6ce5d3,
       whose desktop layout is copy-left / image-right, so the hack pulls the
       image up on a phone. The light sections already have the media first in
       source order and carry no hack at all.
       The port had it inverted (`.svc__copy{order:-1}`), which pushed all
       three photos to the bottom of their block. */
    .svc__media--last {
      order: -1;
    }

    /* The button widget is centre-aligned at <=767 and left-aligned above it */
    .svc__copy {
      align-items: center;
    }
  }
</style>
