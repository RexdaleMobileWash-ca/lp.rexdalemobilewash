---
/**
 * Ported from post-110.css — #1c6b9f7f wrapper, #77e9eca4 row,
 * icon boxes #7e2c743e / #1829e18c / #182c97aa (identical styling).
 */
import { icons } from '../icons';

const steps = [
  {
    title: 'Request a Quote',
    body: 'Fill out our quick online form or call us directly to get a personalized quote for your service needs.',
    icon: icons.commentDots,
  },
  {
    title: 'Schedule Your Service',
    body: 'Choose a convenient date and time for our team to arrive and complete the job efficiently.',
    icon: icons.calendarDay,
  },
  {
    title: 'Get Exceptional Results',
    body: 'Our professionals handle everything, leaving your property spotless and refreshed.',
    icon: icons.checkCircle,
  },
];
---

<!-- #1c6b9f7f : border-bottom 2px solid #9DB6C9, padding 10px, content-width 80vw -->
<section class="steps">
  <div class="steps__inner">
    {
      steps.map((s) => (
        <article class="step">
          {/* .elementor-icon font-size 65px (50px <=1024), colour #164E83 */}
          <span class="step__icon" aria-hidden="true">
            <svg viewBox={s.icon.vb} fill="currentColor">
              <path d={s.icon.d} />
            </svg>
          </span>
          {/* .elementor-icon-box-title SSP 22px/600 #376898 (20px <=767) */}
          <h3 class="step__title">{s.title}</h3>
          {/* description Montserrat 16px/400 #000 */}
          <p class="step__body">{s.body}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .steps {
    border-bottom: 2px solid var(--c-blue-grey);
    padding: 10px;
  }

  /* The live row #77e9eca4 has no padding of its own and a 20px gap — the
     invented 40px band pushed everything below it down by 80px. */
  .steps__inner {
    width: 100%;
    max-width: var(--wrap-max);
    margin-inline: auto;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 20px;
  }

  /* The spacing inside an icon box comes from the title's own margins
     (8px above, 5px below), not from a flex gap. */
  .step {
    flex: 1 1 240px;
    padding: 10px;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .step__icon {
    color: var(--c-blue);
    display: inline-flex;
  }

  .step__icon svg {
    width: 65px;
    height: 65px;
  }

  .step__title {
    font-family: var(--f-head);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2em;
    color: var(--c-blue-mid);
    /* 8px below the icon, 5px above the description */
    margin: 8px 0 5px;
  }

  .step__body {
    font-family: var(--f-body);
    font-size: 16px;
    font-weight: 400;
    color: #000;
    margin: 0;
  }

  @media (min-width: 768px) {
    .steps {
      --content-width: 80vw;
    }
    .steps__inner {
      width: 80vw;
    }
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .steps__inner {
      width: 100vw;
    }
  }

  @media (max-width: 1024px) {
    .step__icon svg {
      width: 50px;
      height: 50px;
    }
  }

  @media (max-width: 767px) {
    .step__title {
      font-size: 20px;
    }
  }
</style>
