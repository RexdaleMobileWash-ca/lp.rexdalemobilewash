---
/**
 * Ported from post-110.css — #65980114 section and the contact panel #43011b9f.
 *
 * Note the contact details, socials and "Areas We Serve" are NOT part of the
 * theme footer. They are a blue rounded panel inside this page section. The
 * theme footer (post-18.css) is only the privacy link + copyright bar.
 */
import EstimateForm from './EstimateForm.astro';
import { icons } from '../icons';

/* #2484af25 : a map-pin against each city, a plus against "and more!" */
const areas = [
  { label: 'Toronto', icon: icons.mapPin },
  { label: 'Brampton', icon: icons.mapPin },
  { label: 'Mississauga', icon: icons.mapPin },
  { label: 'Vaughan', icon: icons.mapPin },
  { label: 'Etobicoke', icon: icons.mapPin },
  { label: 'North York', icon: icons.mapPin },
  { label: 'and more!', icon: icons.plus },
];

const socials = [
  { href: 'https://www.instagram.com/rexdalemobilewash/', label: 'Instagram', icon: icons.instagram },
  { href: 'https://www.facebook.com/rexdalemobilewash', label: 'Facebook', icon: icons.facebook },
  { href: 'https://twitter.com/RexMobileWash', label: 'X (Twitter)', icon: icons.xTwitter },
];
---

<!-- #65980114 : bg #D4E4ED, column, padding 100px, content-width 80vw -->
<section class="cta" id="quote">
  <div class="cta__inner">
    <!-- #6e0980b4 : centred, 40px, #164E83 -->
    <h2 class="h-sec cta__title">Your Solution for Cleaner Spaces Starts Here</h2>

    <!-- #26061421 : Montserrat 20px/500 #376898 centred -->
    <h3 class="cta__sub">Request Your Free, No-Obligation Quote Now!</h3>

    <!-- #440944ae : width 40% (60% <=1024, 90% <=767), align-self center -->
    <div class="cta__form">
      <EstimateForm variant="cta" id="cta" />
    </div>

    <!-- #43011b9f : bg #164E83, radius 5px, margin-top 30px, padding 25px -->
    <div class="cta__panel">
      <!-- #3831df68 : icon #D4E4ED 20px, text SSP 20px/400 #FFF -->
      <ul class="cta__contact">
        <li>
          <svg viewBox={icons.phoneAlt.vb} aria-hidden="true"><path d={icons.phoneAlt.d} /></svg>
          <a href="tel:4162446497">(416) 244-6497</a>
        </li>
        <li>
          <svg viewBox={icons.envelope.vb} aria-hidden="true"><path d={icons.envelope.d} /></svg>
          <a href="mailto:dispatch@rexdalemobilewash.ca">dispatch@rexdalemobilewash.ca</a>
        </li>
        <li>
          <svg viewBox={icons.directions.vb} aria-hidden="true"><path d={icons.directions.d} /></svg>
          <a href="https://maps.app.goo.gl/bawp5JLxv2pj6ByW6" target="_blank" rel="noopener noreferrer">Get Directions</a>
        </li>
      </ul>

      <!-- #17316804 : icon 18px, 36px button, radius 10%, bg #D4E4ED,
           icon #164E83, hover #FFF, 15px half-gutter each side -->
      <ul class="cta__social">
        {
          socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                <svg viewBox={s.icon.vb} aria-hidden="true"><path d={s.icon.d} /></svg>
              </a>
            </li>
          ))
        }
      </ul>

      <!-- #3370538 : SSP 25px/1em #D4E4ED, centred -->
      <h3 class="cta__areas-title">Areas We Serve</h3>

      <!-- #2484af25 : icon #D4E4ED, text SSP 20px/400 #FFF -->
      <ul class="cta__areas">
        {
          areas.map((a) => (
            <li>
              <svg viewBox={a.icon.vb} aria-hidden="true">
                <path d={a.icon.d} />
              </svg>
              <span>{a.label}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .cta {
    background-color: var(--c-blue-pale);
    padding: 100px 10px;
  }

  /* 20px of widget spacing between heading, sub-heading, form and panel */
  .cta__inner {
    width: 100%;
    max-width: var(--wrap-max);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    row-gap: 20px;
  }

  .cta__title {
    text-align: center;
    margin: 0;
  }

  .cta__sub {
    font-family: var(--f-body);
    font-size: 20px;
    font-weight: 500;
    color: var(--c-blue-mid);
    text-align: center;
    margin: 0;
  }

  .cta__form {
    width: 90%;
    align-self: center;
  }

  /* 20px of widget spacing between the contact list, the socials, the
     "Areas We Serve" heading and the area list */
  .cta__panel {
    width: 100%;
    background-color: var(--c-blue);
    border-radius: 5px;
    margin-top: 30px;
    padding: 25px;
    display: flex;
    flex-direction: column;
    row-gap: 20px;
  }

  /* Both of these widgets carry Elementor's .elementor-inline-items at EVERY
     width, not just on desktop: the items lay out in a centred wrapping row.
     The contact rows are wide enough that they still break one per line on a
     phone, but the seven area names pack three to a row — the port stacked
     them, which added ~90px and lost the shape of the block. */
  .cta__contact,
  .cta__areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }

  .cta__contact {
    column-gap: 20px;
  }

  .cta__areas {
    column-gap: 5px;
  }

  /* These two lists are laid out inline, so unlike .ticks they carry no
     per-item vertical half-gap. */
  .cta__contact li,
  .cta__areas li {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .cta__contact svg,
  .cta__areas svg {
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
    fill: var(--c-blue-pale);
  }

  .cta__contact a,
  .cta__contact li > span,
  .cta__areas span {
    font-family: var(--f-head);
    font-size: 20px;
    font-weight: 400;
    color: #fff;
    text-decoration: none;
    transition: color 0.3s;
  }

  .cta__contact a:hover {
    text-decoration: underline;
  }

  .cta__social {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    justify-content: center;
    /* Elementor's 15px grid gutter is a half-gutter each side, so the gap
       between two buttons is 30px, not 15px. */
    column-gap: 30px;
  }

  /* 36px square with a 10% radius — a rounded square, not a circle */
  .cta__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 10%;
    background-color: var(--c-blue-pale);
  }

  .cta__social svg {
    width: 18px;
    height: 18px;
    fill: var(--c-blue);
    transition: fill 0.3s;
  }

  .cta__social a:hover {
    background-color: var(--c-blue-mid);
  }

  .cta__social a:hover svg {
    fill: #fff;
  }

  .cta__areas-title {
    font-family: var(--f-head);
    font-size: 25px;
    font-weight: 600;
    line-height: 1em;
    color: var(--c-blue-pale);
    text-align: center;
    /* 15px on top of the panel's 20px widget spacing */
    margin: 15px 0 0;
  }

  @media (min-width: 768px) {
    .cta__inner {
      width: 80vw;
    }
    .cta__form {
      width: 40%;
    }
  }

  @media (min-width: 768px) and (max-width: 1024px) {
    .cta__inner {
      width: 100vw;
    }
  }

  @media (max-width: 1024px) {
    .cta {
      padding: 50px 10px;
    }
    .cta__form {
      width: 60%;
    }
    .cta__sub {
      font-size: 18px;
    }
    .cta__contact a {
      font-size: 18px;
    }
    .cta__areas span {
      font-size: 18px;
      line-height: 1.3em;
    }
  }

  @media (max-width: 767px) {
    .cta__form {
      width: 90%;
    }
    .cta__sub {
      font-size: 16px;
      line-height: 1.3em;
    }
    .cta__panel {
      padding: 15px;
    }
  }
</style>
