---
/**
 * Ported from post-110.css.
 * Two instances on the page with different button colours:
 *   #66157053  hero panel   — submit bg #D4E4ED, text #164E83, hover bg #9DB6C9
 *   #440944ae  closing CTA  — submit bg #164E83, text #FFFFFF, hover bg #376898
 * Fields are identical in both: Montserrat 400, #000 text, white bg,
 * 1px #D4E4ED border, 5px radius, 10px gutter, 10px bottom margin.
 *
 * The original posted to WordPress admin-ajax (Elementor Pro Forms), which does
 * not exist in a static build. It now posts to /api/estimate, handled by
 * worker/index.js, which mails the submission through Mailgun. Field names are
 * unchanged from the original: name, email, phone, city, message.
 *
 * Submits over fetch when JS is available, and as a plain form POST when it is
 * not — the worker answers both, redirecting a no-JS success to /thank-you.
 */
interface Props {
  variant?: 'hero' | 'cta';
  id?: string;
}
const { variant = 'hero', id = 'estimate' } = Astro.props;
const ENDPOINT = '/api/estimate';
---

<form class={`ef ef--${variant}`} method="POST" action={ENDPOINT}>
  {/* Tells the client which of the two forms an enquiry came from. `id` is
      already unique per page — it namespaces every field id below. */}
  <input type="hidden" name="source" value={id} />

  {/* Spam traps. _gotcha is hidden from people and left empty by real
      browsers; _ts is stamped by JS on load so a same-instant post is
      recognisable. Both are ignored when absent. */}
  <div class="ef__trap" aria-hidden="true">
    <label for={`${id}-gotcha`}>Leave this field empty</label>
    <input id={`${id}-gotcha`} name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="_ts" value="" />
  <div class="ef__row">
    <label class="visually-hidden" for={`${id}-name`}>Name</label>
    <input id={`${id}-name`} name="name" type="text" placeholder="Name*" required />
  </div>

  <div class="ef__row">
    <label class="visually-hidden" for={`${id}-email`}>Email</label>
    <input id={`${id}-email`} name="email" type="email" placeholder="Email*" required />
  </div>

  <div class="ef__row ef__row--split">
    <div>
      <label class="visually-hidden" for={`${id}-phone`}>Phone</label>
      <input id={`${id}-phone`} name="phone" type="tel" placeholder="Phone*" required />
    </div>
    <div>
      <label class="visually-hidden" for={`${id}-city`}>City</label>
      <input id={`${id}-city`} name="city" type="text" placeholder="City" />
    </div>
  </div>

  <div class="ef__row">
    <label class="visually-hidden" for={`${id}-message`}>Message</label>
    <textarea id={`${id}-message`} name="message" rows="3" placeholder="Message"></textarea>
  </div>

  <div class="ef__row">
    <button type="submit">Submit</button>
  </div>

  <p class="ef__notice" role="status" aria-live="polite" hidden></p>
</form>

<script>
  document.querySelectorAll('.ef').forEach((formEl) => {
    const form = formEl as HTMLFormElement;
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const notice = form.querySelector('.ef__notice') as HTMLElement | null;
    const stamp = form.querySelector('input[name="_ts"]') as HTMLInputElement | null;

    if (stamp) stamp.value = String(Date.now());

    const show = (message: string, kind: 'ok' | 'error') => {
      if (!notice) return;
      notice.textContent = message;
      notice.dataset.kind = kind;
      notice.hidden = false;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (button?.disabled) return;

      if (notice) notice.hidden = true;
      const label = button?.textContent ?? 'Submit';
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending…';
      }

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.ok) {
          window.location.assign('/thank-you');
          return;
        }
        show(
          data.message || 'We could not send that just now — please call (416) 244-6497.',
          'error'
        );
      } catch {
        show('Network error — please call (416) 244-6497.', 'error');
      }

      if (button) {
        button.disabled = false;
        button.textContent = label;
      }
    });
  });
</script>

<style>
  .ef {
    display: flex;
    flex-direction: column;
    /* .elementor-form-fields-wrapper margin-bottom:-10px */
    margin-bottom: -10px;
  }

  /* .elementor-field-group : margin-bottom 10px, 10px/2 side padding */
  .ef__row {
    margin-bottom: 10px;
  }

  .ef__row--split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  /* Honeypot. Off-canvas rather than display:none — some bots skip fields
     they can tell are not rendered. */
  .ef__trap {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  input,
  textarea {
    width: 100%;
    font-family: var(--f-body);
    font-weight: 400;
    font-size: 15px;
    color: #000;
    background-color: #fff;
    border: 1px solid var(--c-blue-pale);
    border-radius: 5px;
    padding: 12px 14px;
  }

  input::placeholder,
  textarea::placeholder {
    color: #8a8a8a;
  }

  input:focus-visible,
  textarea:focus-visible {
    outline: 2px solid var(--c-blue-mid);
    outline-offset: 1px;
  }

  textarea {
    resize: vertical;
    min-height: 76px;
  }

  /* .elementor-button : Source Sans Pro 18px 500 uppercase */
  button[type='submit'] {
    width: 100%;
    font-family: var(--f-head);
    font-size: 18px;
    font-weight: 500;
    text-transform: uppercase;
    border: 0;
    border-radius: 3px;
    padding: 13px 20px;
    cursor: pointer;
    transition: background-color 0.3s, color 0.3s;
  }

  /* #66157053 */
  .ef--hero button[type='submit'] {
    background-color: var(--c-blue-pale);
    color: var(--c-blue);
  }

  .ef--hero button[type='submit']:hover {
    background-color: var(--c-blue-grey);
    color: var(--c-blue);
  }

  /* #440944ae */
  .ef--cta button[type='submit'] {
    background-color: var(--c-blue);
    color: #fff;
  }

  .ef--cta button[type='submit']:hover {
    background-color: var(--c-blue-mid);
    color: #fff;
  }

  button[type='submit']:disabled {
    cursor: progress;
    opacity: 0.7;
  }

  .ef__notice {
    margin: 4px 0 0;
    font-size: 14px;
    padding: 8px 10px;
    border-radius: 3px;
  }

  /* The hero form sits on a photo, so it needs its own contrast treatment. */
  .ef--hero .ef__notice {
    color: #fff;
    background: rgb(0 0 0 / 25%);
  }

  .ef--cta .ef__notice[data-kind='error'] {
    color: #b3261e;
    background: #fdecea;
  }

  .ef--cta .ef__notice[data-kind='ok'] {
    color: #17603f;
    background: #e7f4ec;
  }

  @media (max-width: 480px) {
    .ef__row--split {
      grid-template-columns: 1fr;
    }
  }
</style>
