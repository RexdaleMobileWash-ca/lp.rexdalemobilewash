---
/** Ported from post-23.css — .elementor-23 (theme-builder header) */
const LOGO =
  'https://lp.rexdalemobilewash.ca/wp-content/uploads/2025/03/Rexdale-Mobile-Wash-Logo.webp';
---

<header class="hdr">
  <!-- #28402046 : row, align center, bg #FFFFFF, content-width 1400px -->
  <div class="hdr__inner">
    <!-- #4b38bd4e : width 75% (50% <=767), padding 10px -->
    <div class="hdr__brand">
      <!-- #15be2f65 : text-align start. Original img width 18% / 16% <=1024 /
           38% <=767. The mobile 38% is restored: it makes the logo 67px and
           the header band 87px, as on the live site. Desktop is still capped
           below the original 18% by the max-width below. -->
      <a href="https://www.rexdalemobilewash.ca/">
        <img src={LOGO} alt="Rexdale Mobile Wash - Logo" width="200" height="200" />
      </a>
    </div>

    <!-- #1727c813 : width 25% (50% <=767) -->
    <div class="hdr__cta">
      <!-- #3ecf2179 : bg #164E83, Montserrat 500, #FFF, padding 5px 15px, hover #376898 -->
      <a href="tel:4162446497" class="hdr__btn">
        <span class="hdr__btn-lead">Contact Us</span><br />(416) 244-6497
      </a>
    </div>
  </div>
</header>

<style>
  .hdr {
    background-color: #fff;
    box-shadow: 0 0 10px 0 rgb(0 0 0 / 50%);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .hdr__inner {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
  }

  .hdr__brand {
    width: 75%;
    padding: 6px 10px;
    text-align: start;
  }

  /* img width is a percentage of its container on the original, not a fixed px.
     The cap keeps the logo — and so the header band — from growing unbounded
     on wide viewports. */
  .hdr__brand img {
    width: 13%;
    min-width: 56px;
    max-width: 130px;
    height: auto;
    display: block;
  }

  .hdr__cta {
    width: 25%;
    display: flex;
    justify-content: flex-end;
    padding-right: 10px;
  }

  .hdr__btn {
    background-color: var(--c-blue);
    color: #fff;
    fill: #fff;
    font-family: var(--f-body);
    font-weight: 500;
    font-size: 15px;
    /* The live button is two differently-sized lines: an inline
         <span style="font-size:12px;line-height:1.5em">Contact Us</span>
       over the number at the button's own 15px/1. That is what makes it
       43px tall rather than 49px. */
    line-height: 1;
    text-align: center;
    text-decoration: none;
    padding: 5px 15px;
    border-radius: 3px;
    transition: background-color 0.3s;
  }

  .hdr__btn-lead {
    font-size: 12px;
    line-height: 1.5em;
  }

  .hdr__btn:hover,
  .hdr__btn:focus {
    background-color: var(--c-blue-mid);
  }

  @media (max-width: 1024px) {
    .hdr__brand img {
      width: 12%;
    }
  }

  @media (max-width: 767px) {
    .hdr__brand,
    .hdr__cta {
      width: 50%;
    }
    /* 10px padding around a 38%-wide logo gives the live 67px mark and an
       87px band. Left at 6px above 767 so the desktop header, which is
       already capped smaller than the original by design, does not move. */
    .hdr__brand {
      padding: 10px;
    }
    .hdr__brand img {
      width: 38%;
    }
  }
</style>
