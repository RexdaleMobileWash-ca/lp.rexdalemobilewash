---
/** Ported from post-23.css — .elementor-23 (theme-builder header) */
import { upload } from '../lib/img';

const LOGO = upload('Rexdale-Mobile-Wash-Logo.webp');
---

<header class="hdr">
  <!-- #28402046 : row, align center, bg #FFFFFF, content-width 1400px -->
  <div class="hdr__inner">
    <!-- #4b38bd4e : width 75% (50% <=767), padding 10px -->
    <div class="hdr__brand">
      <!-- #15be2f65 : text-align start. The Elementor original sized the logo
           as a percentage of this column (18% / 16% <=1024 / 38% <=767), which
           is why the band used to measure 142px at 1440 but 78px at 768 and
           107px again at 500 — the percentage is of a column that is 75% wide
           above 767 and 50% below it. The logo is now a fixed height in px
           (--hdr-logo), so the band is one predictable size per state. -->
      <a href="https://www.rexdalemobilewash.ca/">
        <img src={LOGO} alt="Rexdale Mobile Wash - Logo" width="200" height="200" />
      </a>
    </div>

    <!-- #1727c813 : width 25% (50% <=767) -->
    <div class="hdr__cta">
      <!-- #3ecf2179 : bg #164E83, Montserrat 500, #FFF, padding 5px 15px, hover #376898 -->
      <a href="tel:4162446497" class="hdr__btn">
        <span class="hdr__btn-lead">Contact Us</span><br />(416) 244-6497
      </a>
    </div>
  </div>
</header>

<style>
  /* Band height is driven entirely by these two values, so it is the same
     number every time and can be read off without measuring:
         band = --hdr-logo + 2 x --hdr-pad-y
     Desktop 52 + 12 = 64px resting, 38 + 10 = 48px scrolled.
     Mobile 44 + 12 = 56px resting, 36 + 10 = 46px scrolled.
     These sit between the 142px original and the 56/44 that read as too
     small: enough presence at rest to look like a header, still a clear
     16px drop once the page moves.
     The floor is the CTA button, trimmed to 40px below — a band cannot go
     under it without taking the phone tap target below 40px, which is the
     one element on this header that has to stay easy to hit. */
  .hdr {
    --hdr-logo: 52px;
    --hdr-pad-y: 6px;

    background-color: #fff;
    box-shadow: 0 0 10px 0 rgb(0 0 0 / 50%);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  /* Set by the script below once the page is scrolled off the top. */
  .hdr.is-stuck {
    --hdr-logo: 38px;
    --hdr-pad-y: 5px;
    box-shadow: 0 2px 12px 0 rgb(0 0 0 / 35%);
  }

  .hdr__inner {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
  }

  .hdr__brand {
    width: 75%;
    padding: var(--hdr-pad-y) 10px;
    text-align: start;
    transition: padding 0.18s ease;
  }

  /* Sized by height, not width: the band height then does not depend on the
     logo file's aspect ratio, and a replacement logo cannot silently make the
     header tall again. width:auto keeps it undistorted. */
  .hdr__brand img {
    height: var(--hdr-logo);
    width: auto;
    max-width: 100%;
    object-fit: contain;
    display: block;
    transition: height 0.18s ease;
  }

  .hdr__cta {
    width: 25%;
    display: flex;
    justify-content: flex-end;
    padding-right: 10px;
  }

  .hdr__btn {
    background-color: var(--c-blue);
    color: #fff;
    fill: #fff;
    font-family: var(--f-body);
    font-weight: 500;
    font-size: 15px;
    /* Two differently-sized lines: an inline "Contact Us" over the number at
       the button's own 15px/1. Tightening the lead's line-height from the
       live site's 1.5em to 1.25 takes the button from 43px to 40px, which is
       what lets the scrolled band reach 44px. Do not go below 40px — that is
       the minimum comfortable tap target for the phone number. */
    line-height: 1;
    text-align: center;
    text-decoration: none;
    padding: 4px 15px;
    border-radius: 3px;
    transition: background-color 0.3s;
  }

  .hdr__btn-lead {
    font-size: 12px;
    line-height: 1.25;
  }

  .hdr__btn:hover,
  .hdr__btn:focus {
    background-color: var(--c-blue-mid);
  }

  @media (max-width: 767px) {
    .hdr__brand,
    .hdr__cta {
      width: 50%;
    }
    /* Was an 87px band, now 56px resting and 46px scrolled. */
    .hdr {
      --hdr-logo: 44px;
    }
    .hdr.is-stuck {
      --hdr-logo: 36px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hdr__brand,
    .hdr__brand img {
      transition: none;
    }
  }
</style>

<script>
  /* Shrinks the band once the page has moved off the top. The class is the
     only thing this does — every size lives in the CSS above, so the header
     still renders at its full resting size with JS off or before hydration. */
  const hdr = document.querySelector<HTMLElement>('.hdr');

  if (hdr) {
    let queued = false;

    const apply = () => {
      queued = false;
      hdr.classList.toggle('is-stuck', window.scrollY > 8);
    };

    /* Run once on load: a reload part-way down the page starts scrolled. */
    apply();

    window.addEventListener(
      'scroll',
      () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(apply);
      },
      { passive: true },
    );
  }
</script>
