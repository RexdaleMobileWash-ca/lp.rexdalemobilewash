---
/** Ported from post-23.css — .elementor-23 (theme-builder header) */
const LOGO =
  'https://lp.rexdalemobilewash.ca/wp-content/uploads/2025/03/Rexdale-Mobile-Wash-Logo.webp';
---

<header class="hdr">
  <!-- #28402046 : row, align center, bg #FFFFFF, content-width 1400px -->
  <div class="hdr__inner">
    <!-- #4b38bd4e : width 75% (50% <=767), padding 10px -->
    <div class="hdr__brand">
      <!-- #15be2f65 : text-align start, img width 18% / 16% <=1024 / 38% <=767 -->
      <a href="https://www.rexdalemobilewash.ca/">
        <img src={LOGO} alt="Rexdale Mobile Wash - Logo" width="200" height="200" />
      </a>
    </div>

    <!-- #1727c813 : width 25% (50% <=767) -->
    <div class="hdr__cta">
      <!-- #3ecf2179 : bg #164E83, Montserrat 500, #FFF, padding 5px 15px, hover #376898 -->
      <a href="tel:4162446497" class="hdr__btn">
        Contact Us<br />(416) 244-6497
      </a>
    </div>
  </div>
</header>

<style>
  .hdr {
    background-color: #fff;
    box-shadow: 0 0 10px 0 rgb(0 0 0 / 50%);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .hdr__inner {
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
  }

  .hdr__brand {
    width: 75%;
    padding: 10px;
    text-align: start;
  }

  /* img width is a percentage of its container on the original, not a fixed px */
  .hdr__brand img {
    width: 18%;
    min-width: 56px;
  }

  .hdr__cta {
    width: 25%;
    display: flex;
    justify-content: flex-end;
    padding-right: 10px;
  }

  .hdr__btn {
    background-color: var(--c-blue);
    color: #fff;
    fill: #fff;
    font-family: var(--f-body);
    font-weight: 500;
    font-size: 15px;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    padding: 5px 15px;
    border-radius: 3px;
    transition: background-color 0.3s;
  }

  .hdr__btn:hover,
  .hdr__btn:focus {
    background-color: var(--c-blue-mid);
  }

  @media (max-width: 1024px) {
    .hdr__brand img {
      width: 16%;
    }
  }

  @media (max-width: 767px) {
    .hdr__brand,
    .hdr__cta {
      width: 50%;
    }
    .hdr__brand img {
      width: 38%;
    }
  }
</style>
