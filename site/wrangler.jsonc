{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "staging-lp-rexdalemobilewash",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-03",

  // Astro builds to dist/ with build.format 'directory', so /privacy-policy
  // resolves to /privacy-policy/index.html. "auto-trailing-slash" handles that;
  // "404-page" serves dist/404.html once one exists, and a plain 404 until then.
  // run_worker_first is required: by default a request matching a static asset
  // is served without invoking the Worker at all, so the noindex header in
  // worker/index.js would never be applied.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },

  // Staging is served on the workers.dev URL only. A custom domain
  // (staging.lp.rexdalemobilewash.ca) cannot work while rexdalemobilewash.ca
  // is on GoDaddy nameservers: Cloudflare is not authoritative, and the zone is
  // 'full' on a Free plan so CNAME setup is not an option either. Adding a
  // "routes" entry here would also switch workers.dev off unless
  // workers_dev is set explicitly alongside it.
  "workers_dev": true,

  // Contact-form addressing. Non-secret on purpose — these are the values worth
  // seeing in review, and the only credential is RESEND_API_KEY (below).
  //
  // CONTACT_FROM must stay on the SHARED sending domain. rexdalemobilewash.ca is
  // never a sending domain here: that is what keeps the client's Microsoft 365
  // mail reputation entirely out of reach of this Worker.
  "vars": {
    "SITE_NAME": "Rexdale Mobile Wash",
    "CONTACT_FROM": "Rexdale Mobile Wash <forms@brandingcentres.com>",
    "CONTACT_TO": "dispatch@rexdalemobilewash.ca",
    "CONTACT_CC": "Paolo@tboxstudio.com",
    "CONTACT_REPLY_TO": "dispatch@rexdalemobilewash.ca",
    "CONTACT_CONFIRM": "true"
  },

  // NO SECRETS ARE IN THIS FILE, and none may be added to "vars".
  //
  //     CLOUDFLARE_API_TOKEN="$CF_API_TOKEN" npx wrangler secret put RESEND_API_KEY
  //     CLOUDFLARE_API_TOKEN="$CF_API_TOKEN" npx wrangler secret put TURNSTILE_SECRET_KEY
  //
  // Adding either as a Build variable instead is the trap: it is present while
  // the build runs and absent when the route executes, so the build passes and
  // the form fails in production. Both endpoints fail CLOSED without them —
  // /api/contact and /api/quote refuse every submission until they are set.
  //
  // The Turnstile SITEKEY is public and is not a secret, but it is not in this
  // file either: it is baked into the HTML at build time from the environment
  // variable PUBLIC_TURNSTILE_SITEKEY. See site/.env.example.

  // Layer 4, part one: the burst brake. Per-IP, per data centre, and counted on
  // every request that reaches the handler with a body — including ones that
  // will be rejected — so a flood of deliberately malformed payloads is capped
  // before any outbound call is made on its behalf. `period` accepts only 10
  // or 60. Cloudflare documents this binding as permissive and eventually
  // consistent; it is a brake on the naive case, not an accounting system.
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 8, "period": 60 }
    }
  ],

  // Layer 4, part two: the hourly limit the brake above cannot express, since
  // `period` only accepts 10 or 60 seconds. Three ACCEPTED submissions per hour
  // per form per IP, counted in KV by worker/guard.js. Counted on the way out
  // rather than the way in, so a visitor who fumbles validation is not locked
  // out of the form.
  //
  // TODO(setup): this id is a placeholder and `wrangler deploy` will refuse it.
  // Create the namespace once and paste its id here:
  //     CLOUDFLARE_API_TOKEN="$CF_API_TOKEN" npx wrangler kv namespace create FORM_RATE_LIMIT
  // Until then the hourly limit is not enforced and the Worker logs a loud
  // error saying so on every submission; the burst brake above still applies.
  "kv_namespaces": [
    {
      "binding": "FORM_RATE_LIMIT",
      "id": "REPLACE_ME_form_rate_limit_namespace_id"
    }
  ],

  "observability": { "enabled": true }
}
